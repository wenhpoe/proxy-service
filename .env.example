PROXY_ADMIN_PASSWORD=change-me
PROXY_ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
PROXY_ADMIN_SESSION_TTL_SEC=43200
FLOW_MYSQL_HOST=127.0.0.1
FLOW_MYSQL_PORT=3306
FLOW_MYSQL_USER=root
FLOW_MYSQL_PASSWORD=change-me
FLOW_MYSQL_DATABASE=flow_task_system
# Or use a single URL instead:
# FLOW_MYSQL_URL=mysql://root:change-me@127.0.0.1:3306/flow_task_system
# FLOW_MYSQL_POOL_SIZE=10
# Activation code TTL (seconds). Used when /v1/admin/codes has no ttlSec.
# 激活码默认有效期固定为 1 天（服务端不再提供该项配置）
# Default is session cookie (expires when browser closes). To persist:
# PROXY_ADMIN_COOKIE_PERSIST=1
# If you serve Proxy Service over HTTPS, set:
# PROXY_ADMIN_COOKIE_SECURE=1

# Pool auto-check (nodes + Flow precheck)
# PROXY_POOL_AUTOCHECK=1
# PROXY_POOL_NODE_AUTOTOGGLE_INTERVAL_MS=180000
# PROXY_POOL_NODE_AUTOTOGGLE_TRIES=3
# PROXY_POOL_NODE_AUTOTOGGLE_TRY_DELAY_MS=400
# PROXY_POOL_NODE_AUTOTOGGLE_TIMEOUT_MS=3500
# By default, a node must pass Flow precheck (flowCheckStatus=ok) before being auto-enabled:
# PROXY_POOL_NODE_AUTOTOGGLE_REQUIRE_FLOW_OK=1

# Electron 环境下 Flow 预检 node 节点会调用 auto-gen 的 ensure_node_proxy.js helper。
# 建议显式指定 node 路径，避免用 Electron 二进制执行 helper（否则可能在 Dock/任务栏出现多个“管理端”图标）。
# 示例（Apple Silicon Homebrew）：/opt/homebrew/bin/node
# FLOW_NODE_PROXY_HELPER_NODE_BIN=/opt/homebrew/bin/node

# Flow precheck auto loop (checks stale items and can auto-disable failures)
# PROXY_POOL_FLOW_AUTOCHECK=1
# PROXY_POOL_FLOW_AUTOCHECK_INTERVAL_MS=300000
# PROXY_POOL_FLOW_AUTOCHECK_MAX_ITEMS=4
# PROXY_POOL_FLOW_AUTOCHECK_DISABLE_ON_FAIL=1
# PROXY_POOL_FLOW_AUTOCHECK_LOG=1

# Flow precheck behavior (used by both manual and auto checks)
# PROXY_POOL_FLOW_CHECK_URL=https://labs.google/fx/tools/flow
# PROXY_POOL_FLOW_CHECK_TIMEOUT_MS=15000
# PROXY_POOL_FLOW_CHECK_TTL_SECONDS=1800
# PROXY_POOL_FLOW_CHECK_FAIL_TTL_SECONDS=3600

# Make Flow precheck requests look like a real browser (recommended)
# PROXY_POOL_FLOW_CHECK_REAL_HEADERS=1
# PROXY_POOL_FLOW_CHECK_USER_AGENT=Mozilla/5.0 (...) Chrome/148.0.7778.97 Safari/537.36
# PROXY_POOL_FLOW_CHECK_ACCEPT_LANGUAGE=zh-CN,zh;q=0.9,en-US;q=0.8,en;q=0.7
# PROXY_POOL_FLOW_CHECK_CHROME_MAJOR=148
# Provide full headers as JSON to override the built-in preset:
# PROXY_POOL_FLOW_CHECK_HEADERS_JSON={"Accept":"...","Accept-Language":"...","sec-ch-ua":"..."}
